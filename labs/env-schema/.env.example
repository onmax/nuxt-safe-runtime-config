# Deployment supplies this credential. The example is documentation only.
# @type=string(minLength=12) @example="LAB_EXAMPLE_SECRET_NEVER_A_DEFAULT"
NUXT_API_SECRET=

# Keep the exact host string, including numeric-looking values.
# @type=string @example="LAB_EXAMPLE_PIN_NEVER_A_DEFAULT"
NUXT_ACCOUNT_PIN=

# @sensitive=false @type=number(min=0, isInt=true)
NUXT_RETRIES=

# @optional @sensitive=false @type=number(min=0)
NUXT_OPTIONAL_LIMIT=

# @public @type=boolean
NUXT_PUBLIC_REPLAY_ENABLED=false

# @public @type=number(min=0, max=1)
NUXT_PUBLIC_TELEMETRY_SAMPLE_RATE=0.1

# @public @type=enum(debug, info, warn, error)
NUXT_PUBLIC_LOG_LEVEL=info

# @public @type=url
NUXT_PUBLIC_API_BASE=https://example.test/api

# A real default must not hide an explicitly empty required override.
# @public @type=string
NUXT_PUBLIC_DISPLAY_LABEL=Deployment lab

# @sensitive=false @type=array(enum(read, write))
NUXT_ROLES='["read"]'

# @sensitive=false @type=object(enabled=boolean, retries=number(min=0, isInt=true), tags=array(string))
NUXT_SETTINGS='{"enabled":false,"retries":3,"tags":[]}'

# @optional @sensitive=false @type=object
NUXT_METADATA=
